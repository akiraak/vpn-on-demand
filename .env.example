# Copy to .env (not committed) and fill in the values.
# Used only by development tests (for example, checking from WSL that the app's
# servers were deleted). The app itself stores keys in the OS credential store.

# Vultr: Account -> API
VULTR_API_KEY=

# Tailscale: Settings -> Keys (Reusable + Ephemeral, tagged). Used by
# app/src-tauri/examples/measure.rs, which creates a server to time the connect flow.
TAILSCALE_AUTH_KEY=

# Fly.io: dashboard -> your organization -> Tokens (an org token, "FlyV1 fm2_...", copy the whole
# string). Used by app/src-tauri/examples/measure_fly.rs, which runs Machines to time the connect flow.
FLY_API_TOKEN=
